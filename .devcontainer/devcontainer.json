{
  // Name shown in the VS Code Dev Containers UI.
  "name": "ESP32 Embedded",

  // Image built from the local Dockerfile; the container user matches
  // the host user so bind-mounted files keep their ownership.
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "CONTAINER_USER": "${localEnv:USER}"
      }
    },

  // Open the container as the host user to avoid file ownership issues.
  "remoteUser": "${localEnv:USER}",

  // Mount the repo at its host path: ESP-IDF's CMake cache stores absolute paths,
  // so builds made here stay valid for flashing from the host.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // Named volume keeps PlatformIO toolchains between container rebuilds.
  "mounts": [
    "source=platformio-cache,target=/home/${localEnv:USER}/.platformio,type=volume"
  ],

  // Settings below apply only to the VS Code session inside the container.
  "customizations": {
    "vscode": {
      "extensions": [
        "platformio.platformio-ide",
        "editorconfig.editorconfig"
      ],
      "settings": {
        // Use PlatformIO Core from the image venv, not a second bundled copy.
        "platformio-ide.useBuiltinPIOCore": false,
        // Skip PIO Home: its web server times out in the container and is not needed.
        "platformio-ide.disablePIOHomeStartup": true,
        // Format with the image's clang-format, the same version as CI.
        "C_Cpp.clang_format_path": "/usr/bin/clang-format",
        // Keep IntelliSense on even if a user setting disabled it.
        "C_Cpp.intelliSenseEngine": "default",
        // One clang-ready compile DB for all projects, built by scripts/ide_cdb.py.
        "C_Cpp.default.compileCommands": [
          "${workspaceFolder}/compile_commands.json"
        ]
      }
    }
  }
}
